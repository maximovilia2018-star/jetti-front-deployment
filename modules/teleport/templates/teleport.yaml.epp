<%- |
String $hostname,
String $tele_env,
String $tele_grp
| -%>
version: v3
teleport:
  nodename: <%= $hostname %>
  auth_token: 0c3a633af933fbb243a3a9f7fa37c347382f444e66ec3685
  data_dir: /var/lib/teleport
  proxy_server: teleport.x100group.com:443
  log:
    output: stderr
    severity: WARNING
    format:
      output: text
  ca_pin: sha256:7600b3aa6b6579796258000802fbcd9c2ed3dcdb7fb70124fcc94fb0e99879c5
  diag_addr: ""
auth_service:
  enabled: "no"
ssh_service:
  enabled: "yes"
  labels:
    env: <%= $tele_env %>
    group: <%= $tele_grp %>
  commands:
  - name: hostname
    command: [hostname]
    period: 1m0s
proxy_service:
  enabled: "no"
  https_keypairs: []
  https_keypairs_reload_interval: 0s
  acme: {}
